-- =============================================================================
-- Evaluation SPROC for AI Functions
-- Generic procedure that works with any AI function
-- =============================================================================
--
-- Use src/create_sproc.py to generate this SPROC with correct stage paths:
--   PYTHONPATH=<SKILL_DIR>/src uv run python src/create_sproc.py evaluate DATABASE SCHEMA STAGE_NAME
--
-- =============================================================================

{% if anonymous %}WITH EVALUATE_AI_FUNCTION AS PROCEDURE ({% else %}CREATE OR REPLACE PROCEDURE {{ database }}.{{ schema }}.EVALUATE_AI_FUNCTION({% endif %}
    FUNCTION_NAME VARCHAR,
    TEST_TABLE VARCHAR,
    INPUT_COLUMNS ARRAY,
    LABEL_COLUMN VARCHAR,
    METRIC_NAME VARCHAR,
    MODEL_NAME VARCHAR,
    SAMPLE_SIZE INTEGER DEFAULT NULL,
    EXPERIMENT_NAME VARCHAR DEFAULT NULL,
    METRIC_OPTIONS VARIANT DEFAULT NULL,
    MAX_LENGTH INTEGER DEFAULT 500,
    CUSTOM_METRIC_UDF VARCHAR DEFAULT NULL,
    RUN_ID VARCHAR DEFAULT NULL
)
RETURNS VARIANT
LANGUAGE PYTHON
RUNTIME_VERSION = '3.12'
PACKAGES = ('snowflake-snowpark-python', 'pandas')
{% if inline -%}
HANDLER = '{{ inline_handler }}'
EXECUTE AS CALLER
AS $$
{{ inline_body }}
$${% if not anonymous %};{% endif %}
{%- else -%}
IMPORTS = (
    '@{{ database }}.{{ schema }}.{{ stage_name }}/custom_ai_function_utils.py',
    '@{{ database }}.{{ schema }}.{{ stage_name }}/metrics_core.py',
    '@{{ database }}.{{ schema }}.{{ stage_name }}/snow_gepa_experiment.py'
)
HANDLER = 'metrics_core.evaluate_handler'
EXECUTE AS CALLER{% if not anonymous %};{% endif %}
{%- endif %}
