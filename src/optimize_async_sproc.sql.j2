-- =============================================================================
-- Async Optimization SPROC for AI Functions
-- Creates and executes a Snowflake Task to run optimization in the background
--
-- NOTE: Async control params (WAREHOUSE_NAME, RUN_ID, TIMEOUT_MINUTES) are
-- ordered differently here than in EVALUATE_AI_FUNCTION_ASYNC. Use named
-- parameter syntax when calling to avoid positional errors.
-- =============================================================================
--
-- Use src/create_sproc.py to generate this SPROC:
--   PYTHONPATH=<SKILL_DIR>/src uv run python src/create_sproc.py optimize_async DATABASE SCHEMA STAGE_NAME
--
-- =============================================================================

CREATE OR REPLACE PROCEDURE {{ database }}.{{ schema }}.OPTIMIZE_AI_FUNCTION_ASYNC(
    FUNCTION_NAME VARCHAR,
    TRAINING_TABLE VARCHAR,
    LABEL_COLUMN VARCHAR,
    INPUT_COLUMNS ARRAY,
    METRIC_NAME VARCHAR,
    MODELS ARRAY,
    REFLECTION_MODEL VARCHAR,
    TEST_TABLE VARCHAR DEFAULT NULL,
    AUTO_BUDGET VARCHAR DEFAULT 'light',
    RESULTS_TABLE VARCHAR DEFAULT NULL,
    VALIDATION_FRACTION FLOAT DEFAULT 0.5,
    TEMPERATURE FLOAT DEFAULT 0.7,
    MAX_TOKENS INTEGER DEFAULT 8192,
    METRIC_OPTIONS VARIANT DEFAULT NULL,
    CUSTOM_METRIC_UDF VARCHAR DEFAULT NULL,
    RUN_ID VARCHAR DEFAULT NULL,
    AGGREGATION_METRIC VARCHAR DEFAULT NULL,
    OPTIMIZE_MODE VARCHAR DEFAULT 'body',
    EXPERIMENT_NAME VARCHAR DEFAULT NULL,
    WAREHOUSE_NAME VARCHAR DEFAULT NULL,
    TIMEOUT_MINUTES INTEGER DEFAULT 240
)
RETURNS VARCHAR
LANGUAGE SQL
EXECUTE AS CALLER
AS
$$
DECLARE
    task_name VARCHAR;
    func_short_name VARCHAR;
    input_cols_str VARCHAR;
    models_str VARCHAR;
    metric_opts_str VARCHAR;
    sproc_call VARCHAR;
    create_task_sql VARCHAR;
    current_wh VARCHAR;
    wh_to_use VARCHAR;
    current_role_name VARCHAR;
    wh_grant_count INTEGER;
BEGIN
    -- Generate run_id if not provided
    IF (RUN_ID IS NULL) THEN
        func_short_name := SPLIT_PART(FUNCTION_NAME, '.', -1);
        task_name := 'ai_func_opt_' || func_short_name || '_' || TO_VARCHAR(DATE_PART('epoch_millisecond', CURRENT_TIMESTAMP()));
    ELSE
        task_name := RUN_ID;
    END IF;
    
    -- Determine warehouse to use
    IF (WAREHOUSE_NAME IS NULL) THEN
        SELECT CURRENT_WAREHOUSE() INTO current_wh;
        wh_to_use := current_wh;
    ELSE
        wh_to_use := WAREHOUSE_NAME;
    END IF;
    
    -- Validate that the current role has USAGE on the target warehouse.
    -- Snowflake Tasks run under the owner role, which requires a direct USAGE grant.
    -- Session-level warehouse access (via role hierarchy) is NOT sufficient for tasks.
    SELECT CURRENT_ROLE() INTO current_role_name;
    EXECUTE IMMEDIATE 'SHOW GRANTS TO ROLE "' || REPLACE(current_role_name, '"', '""') || '"';
    SELECT COUNT(*) INTO wh_grant_count
        FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
        WHERE "granted_on" = 'WAREHOUSE'
          AND "privilege" = 'USAGE'
          AND UPPER("name") = UPPER(:wh_to_use);
    
    IF (wh_grant_count = 0) THEN
        RETURN 'ERROR: Role ' || current_role_name || ' does not have a direct USAGE grant on warehouse ' || wh_to_use || '. ' ||
            'Async tasks run under the owner role, which requires an explicit USAGE privilege on the warehouse — ' ||
            'session-level warehouse access through role hierarchy is not sufficient for tasks. ' ||
            'To fix this, either: (1) Grant access: GRANT USAGE ON WAREHOUSE ' || wh_to_use || ' TO ROLE ' || current_role_name || '; ' ||
            'or (2) Pass a warehouse your role already has access to via the WAREHOUSE_NAME parameter. ' ||
            'To see which warehouses your role can use: SHOW GRANTS TO ROLE ' || current_role_name || ' — look for USAGE on WAREHOUSE.';
    END IF;
    
    -- Build input columns array string
    input_cols_str := 'ARRAY_CONSTRUCT(' || ARRAY_TO_STRING(INPUT_COLUMNS, ''',''') || ')';
    input_cols_str := REPLACE(input_cols_str, 'ARRAY_CONSTRUCT(', 'ARRAY_CONSTRUCT(''');
    input_cols_str := REPLACE(input_cols_str, ')', ''')');
    
    -- Build models array string
    models_str := 'ARRAY_CONSTRUCT(' || ARRAY_TO_STRING(MODELS, ''',''') || ')';
    models_str := REPLACE(models_str, 'ARRAY_CONSTRUCT(', 'ARRAY_CONSTRUCT(''');
    models_str := REPLACE(models_str, ')', ''')');
    
    -- Build metric options string
    IF (METRIC_OPTIONS IS NULL) THEN
        metric_opts_str := 'NULL';
    ELSE
        metric_opts_str := 'PARSE_JSON(''' || TO_VARCHAR(METRIC_OPTIONS) || ''')';
    END IF;
    
    -- Build the SPROC call (RUN_ID = task_name for tracking)
    -- Escape single quotes in user-provided strings to prevent SQL injection
    sproc_call := 'CALL {{ database }}.{{ schema }}.OPTIMIZE_AI_FUNCTION(' ||
        '''' || REPLACE(FUNCTION_NAME, '''', '''''') || ''', ' ||
        '''' || REPLACE(TRAINING_TABLE, '''', '''''') || ''', ' ||
        '''' || REPLACE(LABEL_COLUMN, '''', '''''') || ''', ' ||
        input_cols_str || ', ' ||
        '''' || REPLACE(METRIC_NAME, '''', '''''') || ''', ' ||
        models_str || ', ' ||
        '''' || REPLACE(REFLECTION_MODEL, '''', '''''') || ''', ' ||
        COALESCE('''' || REPLACE(TEST_TABLE, '''', '''''') || '''', 'NULL') || ', ' ||
        '''' || REPLACE(AUTO_BUDGET, '''', '''''') || ''', ' ||
        COALESCE('''' || REPLACE(RESULTS_TABLE, '''', '''''') || '''', 'NULL') || ', ' ||
        TO_VARCHAR(VALIDATION_FRACTION) || ', ' ||
        TO_VARCHAR(TEMPERATURE) || ', ' ||
        TO_VARCHAR(MAX_TOKENS) || ', ' ||
        metric_opts_str || ', ' ||
        COALESCE('''' || REPLACE(CUSTOM_METRIC_UDF, '''', '''''') || '''', 'NULL') || ', ' ||
        '''' || REPLACE(task_name, '''', '''''') || ''', ' ||
        COALESCE('''' || REPLACE(AGGREGATION_METRIC, '''', '''''') || '''', 'NULL') || ', ' ||
        '''' || REPLACE(OPTIMIZE_MODE, '''', '''''') || ''', ' ||
        COALESCE('''' || REPLACE(EXPERIMENT_NAME, '''', '''''') || '''', 'NULL') || ')';
    
    -- Create the task (no schedule — single execution only via EXECUTE TASK)
    create_task_sql := 'CREATE OR REPLACE TASK {{ database }}.{{ schema }}."' || REPLACE(task_name, '"', '""') || '"' ||
        ' WAREHOUSE = ' || wh_to_use ||
        ' USER_TASK_TIMEOUT_MS = ' || TO_VARCHAR(TIMEOUT_MINUTES * 60 * 1000) ||
        ' AS ' || sproc_call;
    
    EXECUTE IMMEDIATE create_task_sql;
    
    -- Execute the task immediately (works on suspended tasks, no RESUME needed)
    EXECUTE IMMEDIATE 'EXECUTE TASK {{ database }}.{{ schema }}."' || REPLACE(task_name, '"', '""') || '"';
    
    RETURN task_name;
END;
$$;
