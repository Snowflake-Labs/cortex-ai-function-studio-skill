expanded AS (
    SELECT
        CASE_ID_BASE * 10 + 1 AS CASE_ID,
        CASE_GROUP,
        1 AS VARIANT_ID,
        SUBJECT_V1 AS SUBJECT,
        BODY_V1 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 2 AS CASE_ID,
        CASE_GROUP,
        2 AS VARIANT_ID,
        SUBJECT_V2 AS SUBJECT,
        BODY_V2 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 3 AS CASE_ID,
        CASE_GROUP,
        3 AS VARIANT_ID,
        SUBJECT_V3 AS SUBJECT,
        BODY_V3 AS BODY,
        CUSTOMER_TIER,
        COMPANY_NAME,
        DEFAULT_LABEL,
        EXPECTED_OUTPUT,
        RULE_FAMILY,
        POLICY_EFFECT,
        CURATION_NOTE
    FROM base_cases

    UNION ALL

    SELECT
        CASE_ID_BASE * 10 + 4 AS CASE_ID,
        CASE_GROUP,
        4 AS VARIANT_ID,
        SUBJECT_V4 AS SUBJECT,
        BODY_V4 AS BODY,
