)
SELECT
    h.CASE_ID,
    h.CASE_GROUP,
    h.SUBJECT,
    h.BODY,
    h.CUSTOMER_TIER,
    h.COMPANY_NAME,
    p.POLICY_PROFILE,
    p.POLICY_TEXT,
    p.ENTITLEMENT_TEXT,
    h.DEFAULT_LABEL,
    h.EXPECTED_OUTPUT,
    h.RULE_FAMILY,
    h.POLICY_EFFECT,
    IFF(h.POLICY_EFFECT = 'override', TRUE, FALSE) AS REQUIRES_POLICY_CONTEXT,
    h.CURATION_NOTE,
    CURRENT_TIMESTAMP() AS CURATED_AT
FROM holdout_rows h
JOIN {{ database }}.{{ schema }}.DEMO_COMPANY_ROUTING_POLICY_V6 p USING (COMPANY_NAME)
ORDER BY h.CASE_ID;


